{
  "name": "xmflsct-website",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/fetchBlogs.mjs",
    "dev": "npm run prebuild && astro dev",
    "build": "npm run prebuild && astro build --force",
    "preview": "astro preview",
    "build:cloudflare": "npm run build && wrangler build --experimental-new-config --experimental-cf-build-output",
    "deploy": "npm run build:cloudflare && cf deploy --prebuilt",
    "deploy:dry-run": "npm run build:cloudflare && cf deploy --prebuilt --dry-run"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "cf": "^1.0.0-beta.12",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.147.0"
  }
}
